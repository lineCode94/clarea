{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-dev-3000/types/**/*.ts",
    ".next-dev-3001/types/**/*.ts",
    ".next-dev-3021/types/**/*.ts",
    ".next-dev-3022/types/**/*.ts",
    ".next-dev-3046/types/**/*.ts",
    ".next-dev-3088/types/**/*.ts",
    ".next-dev-3092/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-dev-3097/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
